PORT=3000
DEVICE_ID=home-air-01
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=
# Deployment only: hostname, without https:// or a path.
DOMAIN=

POSTGRES_USER=aircontrol
POSTGRES_DB=aircontrol
POSTGRES_PASSWORD=
# Direct local Node execution; Compose uses internal db:5432.
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional, only used by the Telegram setup helper for now.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
