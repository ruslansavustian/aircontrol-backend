PORT=3000
DEVICE_ID=home-air-01
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=
# Deployment only: hostname, without https:// or a path.
DOMAIN=

POSTGRES_USER=aircontrol
POSTGRES_DB=aircontrol
POSTGRES_PASSWORD=
# Direct local Node execution; Compose uses internal db:5432.
DB_HOST=127.0.0.1
DB_PORT=5432

# Enable daily summaries after token/chat setup.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minimum time between reports; data lookback is configured separately.
TELEGRAM_REPORT_INTERVAL_MINUTES=1440
TELEGRAM_REPORT_WINDOW_MINUTES=1440
